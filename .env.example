# Arquivo local. Copie para .env e preencha apenas no notebook servidor.
# Nunca coloque credenciais reais em arquivos enviados ao GitHub.
CENTRAL_SECRET_KEY=gere-uma-chave-aleatoria-forte
CENTRAL_COOKIE_SECURE=1
# O banco e as fotos ficam em instance/ por padrão.
# CENTRAL_DATABASE=C:/CentralAfiliados/instance/central.sqlite3
# CENTRAL_UPLOAD_FOLDER=C:/CentralAfiliados/instance/uploads
PORT=5000

SHOPEE_APP_ID=COLOQUE_SEU_APP_ID
SHOPEE_APP_SECRET=COLOQUE_SEU_APP_SECRET
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_GEMINI
